# Firebase Console > slimestrikeforce > Project settings > Web app
NEXT_PUBLIC_SLIME_FIREBASE_API_KEY=
NEXT_PUBLIC_SLIME_FIREBASE_AUTH_DOMAIN=slimestrikeforce.firebaseapp.com
NEXT_PUBLIC_SLIME_FIREBASE_PROJECT_ID=slimestrikeforce
NEXT_PUBLIC_SLIME_FIREBASE_APP_ID=

# Firebase App Check > Web app > reCAPTCHA Enterprise site key
NEXT_PUBLIC_SLIME_APPCHECK_SITE_KEY=

# Local development only. Never set this in Vercel Production.
# NEXT_PUBLIC_SLIME_APPCHECK_DEBUG_TOKEN=true

# Koofy Reader HTTP admin API (uses the existing Slime superAdmin login)
NEXT_PUBLIC_READER_ADMIN_URL=https://asia-northeast3-koofy-reader.cloudfunctions.net/readerAdmin
