# Firebase Console > slimestrikeforce > Project settings > Web app
NEXT_PUBLIC_SLIME_FIREBASE_API_KEY=
NEXT_PUBLIC_SLIME_FIREBASE_AUTH_DOMAIN=slimestrikeforce.firebaseapp.com
NEXT_PUBLIC_SLIME_FIREBASE_PROJECT_ID=slimestrikeforce
